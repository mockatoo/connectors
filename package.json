{
	"name": "@mockatoo/connectors",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "24"
	},
	"packageManager": "pnpm@10.15.0",
	"scripts": {
		"lint": "biome check packages package.json",
		"typecheck": "pnpm --filter @mockatoo/connect-better-auth --filter @mockatoo/connect-authjs --filter @mockatoo/mockatoo typecheck",
		"build": "pnpm --filter @mockatoo/connect-better-auth --filter @mockatoo/connect-authjs --filter @mockatoo/mockatoo build",
		"test": "vitest run",
		"docs:check": "node scripts/docs-check.mjs",
		"packed:check": "node scripts/packed-consumer-check.mjs",
		"peers:check": "node scripts/peers-check.mjs",
		"ci": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm docs:check && pnpm packed:check && pnpm peers:check"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@types/node": "^22.20.2",
		"typescript": "^5.9.2",
		"vitest": "^3.2.4"
	}
}
